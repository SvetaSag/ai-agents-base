# LLM via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
MODEL=openai/gpt-4o-mini

# the bank database from docker-compose.yml (host port 5435)
ADMIN_DSN=postgresql://postgres:postgres@localhost:5435/bank
BANK_DSN=postgresql://mcp_reader:mcp_reader@localhost:5435/bank

# where our servers listen (started from the terminal)
MCP_URL=http://localhost:8101/mcp
ANALYST_URL=http://localhost:8102

# Langfuse from docker-compose.yml: these keys are created automatically on first start
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-lesson3
LANGFUSE_SECRET_KEY=sk-lf-lesson3
