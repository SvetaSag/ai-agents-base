# LLM via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
MODEL=google/gemma-4-26b-a4b-it

# Postgres from docker compose (host port 5434) — used by notebooks, scripts and tests on the host.
# Inside docker the services get their own DSNs from docker-compose.yml.
ADMIN_DSN=postgresql://postgres:postgres@localhost:5434/bank
BANK_DSN=postgresql://mcp_reader:mcp_reader@localhost:5434/bank
AGENT_DSN=postgresql://postgres:postgres@localhost:5434/agent

# Part 5: Telegram bot (token from @BotFather). Allowed user ids, comma-separated; empty = everyone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
